# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# Auth ---------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_real_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# Database -----------------------------------------------------------------
# Local dev (no Docker needed):
DATABASE_URL=sqlite:///./mom.db
# Docker compose builds DATABASE_URL from the POSTGRES_* values below and
# ignores this line, so leave it pointing at SQLite for local work.

# Postgres (docker compose only) -------------------------------------------
POSTGRES_USER=mom
POSTGRES_PASSWORD=CHANGE_ME_before_starting_compose
POSTGRES_DB=mom

# Storage ------------------------------------------------------------------
UPLOAD_DIR=backend/app/storage/uploads
EXPORT_DIR=backend/app/storage/exports
MAX_UPLOAD_MB=200

# Governance ---------------------------------------------------------------
# Hard ceiling on tool calls per orchestrator run (runaway-agent guard)
AGENT_MAX_TOOL_CALLS=25
# Actions below this confidence are always routed to a human gate
AGENT_AUTO_APPROVE_THRESHOLD=1.01

# Privacy ------------------------------------------------------------------
PII_SCRUBBING_ENABLED=true

# CORS ---------------------------------------------------------------------
# Vite dev server. Under docker compose the reviewer editor is same-origin
# behind nginx, and compose overrides this with http://localhost:8080.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML backends ---------------------------------------------------------------
# `baseline` needs no model weights and no GPU. Set these to switch on
# Person A's real models (requirements-ml.txt); see backend/app/ml/registry.py.
MOM_STT_BACKEND=baseline
MOM_DIARIZER_BACKEND=baseline
MOM_SEGMENTER_BACKEND=baseline
MOM_EXTRACTOR_BACKEND=baseline

# --- WhisperSTT (only read when MOM_STT_BACKEND=whisper) -------------------
# Model size: tiny|base|small|medium|large-v3. "small" is the practical
# default for a student laptop; "tiny"/"base" if even that is too slow.
MOM_WHISPER_MODEL=small
MOM_WHISPER_DEVICE=cpu
MOM_WHISPER_COMPUTE=int8
# Files longer than this are chunked into overlapping windows instead of
# transcribed in one pass. 0 disables chunking.
MOM_WHISPER_CHUNK_SECONDS=600
MOM_WHISPER_CHUNK_OVERLAP_SECONDS=2

# --- PyannoteDiarizer (only read when MOM_DIARIZER_BACKEND=pyannote) -------
# Gated model: accept the licence at the model's Hugging Face page, then set
# a real token here. Never commit a real HF_TOKEN.
MOM_PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
HF_TOKEN=

# --- EmbeddingAgendaSegmenter (MOM_SEGMENTER_BACKEND=embedding) ------------
MOM_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
MOM_SEGMENT_MIN_SENTENCES=2
MOM_SEGMENT_MAX_SENTENCES=10
MOM_SEGMENT_STD_MULTIPLIER=1.0

# --- TransformerExtractor (MOM_EXTRACTOR_BACKEND=transformer) --------------
MOM_EXTRACTOR_MODEL=paraphrase-multilingual-MiniLM-L12-v2
MOM_EXTRACTOR_THRESHOLD_HIGH=0.55
MOM_EXTRACTOR_THRESHOLD_LOW=0.20
MOM_EXTRACTOR_MIN_WORDS=4

# --- MLflow (optional; evaluation/run_evaluation.py only) ------------------
# Unset = logs to a local ./mlruns/ directory (already gitignored). Point at
# a real tracking server by setting MLFLOW_TRACKING_URI.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=meeting-intelligence-evaluation
